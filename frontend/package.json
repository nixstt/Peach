{
  "name": "spry-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "oidc-client-ts": "3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-oidc-context": "3.2.0",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.14.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.14.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.14.0",
    "vite": "5.4.11",
    "vitest": "2.1.4"
  }
}
