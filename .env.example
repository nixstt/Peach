# Copy to .env for deploy commands. docker compose up does not read this file.
# Leave AWS_ACCESS_KEY_ID out. Use `aws login` or `aws configure` on this machine,
# and OIDC for GitHub Actions.

AWS_REGION=eu-north-1
AWS_PROFILE=
PROJECT_NAME=spry

# A domain you control. Both names go on one certificate in eu-north-1.
APP_DOMAIN=
API_DOMAIN=

# Filled by `make domain`. Do not invent these.
ACM_CERTIFICATE_ARN=
HOSTED_ZONE_ID=

# Google OAuth – set BEFORE deploying auth stack
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cognito domain prefix (you choose this, e.g. spry-auth-<account-last4>)
COGNITO_DOMAIN_PREFIX=

# Filled by `make deploy-auth`. Do not invent these.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
